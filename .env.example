VITE_OPENSUBSONIC_URL=https://your-OPENSUBSONIC-server.com
VITE_OPENSUBSONIC_USERNAME=your-username
VITE_OPENSUBSONIC_PASSWORD=your-password

# ============================================
# Logging Configuration
# ============================================
# Control console log output verbosity and categories

# Global log level: DEBUG, INFO, WARN, ERROR, NONE
# Only logs at or above this level will be displayed
VITE_LOG_LEVEL=INFO

# Enabled log categories (comma-separated) or "all" / "none"
# Available categories:
#   SYSTEM, CONFIG, AUDIO, DECK, MIXER, WAVEFORM, VOLUME_METER,
#   WEBSOCKET, WEBRTC, CONFERENCE, AZURACAST, OPENSUBSONIC, DISCORD,
#   UI, NAVIGATION, DRAG_DROP, QUEUE, AUTOQUEUE, SONG_REGISTRY,
#   LIBRARY, BROWSE, SERVER_AUDIO, SERVER_COMMAND, SERVER_MEDIASOUP,
#   DEBUG, PERFORMANCE
# 
# Examples:
#   VITE_LOG_CATEGORIES=all                    # Enable all categories
#   VITE_LOG_CATEGORIES=none                   # Disable all logging
#   VITE_LOG_CATEGORIES=AUDIO,DECK,MIXER      # Only audio-related logs
#   VITE_LOG_CATEGORIES=WEBRTC,CONFERENCE      # Only conference logs
VITE_LOG_CATEGORIES=all

# Category-specific log levels (override global level for specific categories)
# Uncomment to set different levels for different components:
# VITE_LOG_LEVEL_AUDIO=DEBUG         # Detailed audio debugging
# VITE_LOG_LEVEL_WEBRTC=DEBUG        # Detailed WebRTC debugging
# VITE_LOG_LEVEL_AZURACAST=WARN      # Only warnings and errors for AzuraCast
# VITE_LOG_LEVEL_VOLUME_METER=ERROR  # Silence volume meter logs except errors

# Show timestamps in logs (true/false)
VITE_LOG_TIMESTAMPS=false

# Use emoji icons in log messages (true/false)
VITE_LOG_EMOJI=true

# Recommended production settings (minimal logging):
# VITE_LOG_LEVEL=WARN
# VITE_LOG_CATEGORIES=SYSTEM,ERROR

# Recommended development settings (full logging):
# VITE_LOG_LEVEL=DEBUG
# VITE_LOG_CATEGORIES=all

# ============================================
# Discord Wishbox Configuration
# ============================================
# To enable Discord wishbox integration, you need to:
# 1. Create a Discord Bot in the Discord Developer Portal
# 2. Enable the following intents: GUILDS, GUILD_MESSAGES, MESSAGE_CONTENT
# 3. Invite the bot to your Discord server
# 4. Get the channel ID where wishes/requests will be posted

# Discord Bot Token (required)
# Get this from: https://discord.com/developers/applications
# Navigate to: Your App → Bot → Token → Reset Token / Copy
VITE_DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Channel ID (required)
# The channel where users will post their song wishes/requests
# To get Channel ID: Enable Developer Mode in Discord Settings → Right-click channel → Copy ID
VITE_DISCORD_CHANNEL_ID=your_channel_id_here

# Discord Guild/Server ID (optional)
# The server where your bot is located
# To get Guild ID: Right-click your server icon → Copy Server ID
VITE_DISCORD_GUILD_ID=your_guild_id_here

# ============================================
# How to set up Discord Bot
# ============================================
# 1. Go to: https://discord.com/developers/applications
# 2. Click "New Application" → Give it a name (e.g., "WebDJ Wishbox")
# 3. Go to "Bot" section → Click "Reset Token" → Copy the token → Paste as VITE_DISCORD_BOT_TOKEN
# 4. Scroll down to "Privileged Gateway Intents" → Enable:
#    - MESSAGE CONTENT INTENT (required!)
# 5. Go to "OAuth2" → "URL Generator"
# 6. Select scopes: "bot"
# 7. Select permissions: "Read Messages/View Channels", "Read Message History"
# 8. Copy the generated URL and open it in browser to invite bot to your server
# 9. Create a channel in your Discord server for wishes (e.g., #song-requests)
# 10. Right-click the channel → Copy ID → Paste as VITE_DISCORD_CHANNEL_ID
# 11. Right-click your server icon → Copy Server ID → Paste as VITE_DISCORD_GUILD_ID

# ============================================
# Genre Blacklist Configuration
# ============================================
# When live streaming is active, songs with blacklisted genres cannot be:
# - Dragged to play decks
# - Added to queue (via drag or double-click)
# Songs with blacklisted genres will be automatically removed from the queue
# when streaming starts.
#
# Specify genres as comma-separated list (case-insensitive)
# Genre matching is partial (e.g., "rock" will match "Hard Rock", "Indie Rock")
# Multi-valued genre fields are supported (any match triggers blacklist)
# Special characters (!, ?, etc.) are supported
#
# Examples:
# VITE_BLACKLISTED_GENRES=explicit,nsfw
# VITE_BLACKLISTED_GENRES=explicit,nsfw,political
# VITE_BLACKLISTED_GENRES=parental advisory,explicit content
VITE_BLACKLISTED_GENRES=

