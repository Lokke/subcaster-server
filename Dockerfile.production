# Multi-stage build für optimierte Production-Image
# Use Debian-based Node instead of Alpine for better MediaSoup compatibility
FROM node:24.8.0-bookworm-slim AS builder

# Build-time arguments for versioning
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG VERSION=dev

# Install build dependencies for MediaSoup
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Arbeitsverzeichnis setzen
WORKDIR /app

# ⚠️ KEINE BUILD-TIME ENV VARIABLEN!
# Alle Variablen werden zur RUNTIME geladen (via Docker ENV)
# Dies erlaubt ein universelles Image das mit jedem ENV-Set funktioniert

# Package files kopieren
COPY package*.json ./

# Alle Dependencies installieren (inkl. devDependencies für Build)
RUN npm ci && npm cache clean --force

# Source code kopieren
COPY . .

# Build OHNE spezifische ENV-Variablen
# Der Code lädt Config zur Runtime vom Backend (/api/config)
RUN npm run build

# Production Stage
FROM node:24.8.0-bookworm-slim AS production

# Copy version info from builder stage
ARG GIT_COMMIT
ARG BUILD_DATE
ARG VERSION

# Set version as environment variables for runtime access
ENV APP_VERSION=${VERSION} \
    GIT_COMMIT=${GIT_COMMIT} \
    BUILD_DATE=${BUILD_DATE}

# Arbeitsverzeichnis setzen
WORKDIR /app

# Install build dependencies for MediaSoup (needed for native compilation)
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    python3-pip \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Kopiere Server-spezifisches package.json (nur Server-Dependencies!)
COPY package.server.json ./package.json
COPY package-lock.json ./

# Installiere NUR Server-Dependencies (ohne Capacitor, three.js, etc.)
RUN npm ci --omit=dev && npm cache clean --force

# Build-Artefakte kopieren (nur Server-Code!)
COPY --from=builder /app/unified-server.js ./
COPY --from=builder /app/server ./server

# Non-root User erstellen  
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -s /bin/bash -m nodejs

# docker-data Verzeichnis erstellen und Ownership setzen
RUN mkdir -p /app/docker-data && \
    chown -R nodejs:nodejs /app/docker-data

# Ownership ändern
RUN chown -R nodejs:nodejs /app
USER nodejs

# Port freigeben
EXPOSE 31337

# Health-Check hinzufügen
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:31337/health || exit 1

# Server starten
CMD ["node", "unified-server.js"]